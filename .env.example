# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Any OpenAI-compatible API works; switch provider by changing these three lines.

# Google Gemini (free tier):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-flash-lite-latest
# Used when the main model is overloaded (503) or missing. Optional.
LLM_FALLBACK_MODEL=gemini-flash-latest

# Groq (free tier):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Test data in data/units.json has calendars "updated" at this moment.
# Pinning the clock keeps the demo stable; remove it for real data.
APP_FIXED_NOW=2026-11-19T12:00:00

# PostgreSQL from docker-compose.yml (docker compose up -d db), then: alembic upgrade head.
# Remove the line to run with in-memory storage (data lost on restart).
DATABASE_URL=postgresql+psycopg://apart:apart@localhost:5433/apartworld
